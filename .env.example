# CodeSentinel API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token (for private repos & higher rate limits)
# Without this, only public repos work (60 requests/hour)
# With this, you get 5000 requests/hour
GITHUB_TOKEN=

# Gemini Model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
